# ==========================================
# Учётные данные для доступа к Экзаменариуму
# ==========================================

# Логин для входа (по умолчанию: admin)
AUTH_USER=admin

# Пароль для входа (по умолчанию: exam2026)
AUTH_PASS=exam2026

# Секретный ключ для криптографической подписи сессионных cookie (HMAC SHA-256)
# Рекомендуется сгенерировать случайную строку в продакшене (например, на Vercel)
AUTH_SECRET=examarium-auth-secret-key-2026-gosy-vak
